<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with NoActionBar for maximum performance -->
    <style name="Theme.Mewsic" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_emerald</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:navigationBarColor">@color/nav_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>
</resources>
