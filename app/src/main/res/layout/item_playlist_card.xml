<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlistCardContainer"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_song_card_idle"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Playlist Cover Art (First song's thumbnail or placeholder) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPlaylistCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#16222F"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#253545"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivPlaylistCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tab_playlist" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Playlist Metadata -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            tools:text="Favorites" />

        <TextView
            android:id="@+id/tvPlaylistTrackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="#898D8E"
            android:textSize="12sp"
            tools:text="8 tracks" />
    </LinearLayout>

    <!-- More Options Button -->
    <FrameLayout
        android:id="@+id/btnPlaylistMore"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_more_vert"
            app:tint="#898D8E" />
    </FrameLayout>

</LinearLayout>
