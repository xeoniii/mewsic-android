<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- Main Content Container with Top Rounded Navigation Bar & Swipeable Pages -->
    <LinearLayout
        android:id="@+id/blankContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Rounded Navigation Bar Container -->
        <FrameLayout
            android:id="@+id/topBarWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/tabBarContainer"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_top_nav_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="7dp"
                android:paddingEnd="8dp"
                android:paddingBottom="7dp">

                <!-- 1. Home Tab -->
                <FrameLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/tabHomeCircle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_tab_selector">

                        <ImageView
                            android:id="@+id/ivTabHome"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_home"
                            app:tint="@color/nav_tab_tint_selector" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 2. Harbour / Globe Tab -->
                <FrameLayout
                    android:id="@+id/tabHarbour"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/tabHarbourCircle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_tab_selector">

                        <ImageView
                            android:id="@+id/ivTabHarbour"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_harbour"
                            app:tint="@color/nav_tab_tint_selector" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 3. Library Tab -->
                <FrameLayout
                    android:id="@+id/tabLibrary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/tabLibraryCircle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_tab_selector">

                        <ImageView
                            android:id="@+id/ivTabLibrary"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_library"
                            app:tint="@color/nav_tab_tint_selector" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 4. Playlist Tab -->
                <FrameLayout
                    android:id="@+id/tabPlaylist"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/tabPlaylistCircle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_tab_selector">

                        <ImageView
                            android:id="@+id/ivTabPlaylist"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_playlist"
                            app:tint="@color/nav_tab_tint_selector" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 5. Settings Tab -->
                <FrameLayout
                    android:id="@+id/tabSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/tabSettingsCircle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_tab_selector">

                        <ImageView
                            android:id="@+id/ivTabSettings"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_settings"
                            app:tint="@color/nav_tab_tint_selector" />
                    </FrameLayout>
                </FrameLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Swipeable Blank Canvas ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Loading Screen Container (Fades out into the blank page) -->
    <FrameLayout
        android:id="@+id/loadingScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark">

        <!-- Soft Ambient Halo Glow behind center -->
        <View
            android:id="@+id/ambientGlow"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ambient_glow" />

        <!-- Center Branding Container -->
        <LinearLayout
            android:id="@+id/brandingContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Logo + Title Row -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- App Icon -->
                <ImageView
                    android:id="@+id/ivAppIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/content_desc_logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mewsic_logo" />

                <!-- App Title -->
                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.01"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />

            </LinearLayout>

            <!-- Loading Bar Track -->
            <FrameLayout
                android:id="@+id/loadingTrack"
                android:layout_width="190dp"
                android:layout_height="3.5dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_loading_track"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Filling Indicator Bar (animates scaleX from 0f to 1f with midpoint hiccup) -->
                <View
                    android:id="@+id/loadingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_loading_indicator" />

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
