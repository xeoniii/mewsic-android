<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- Main Content Container with Top Rounded Navigation Bar & Swipeable Pages -->
    <LinearLayout
        android:id="@+id/blankContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Floating Navigation Bar Container -->
        <FrameLayout
            android:id="@+id/topBarWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <!-- Floating Pill Dock -->
            <FrameLayout
                android:id="@+id/tabBarContainer"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/bg_top_nav_container"
                android:clipChildren="false"
                tools:targetApi="q"
                android:forceDarkAllowed="false">

                <!-- Smooth Sliding Active Indicator Circle -->
                <View
                    android:id="@+id/activeIndicator"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|start"
                    android:background="@drawable/bg_indicator_circle"
                    tools:targetApi="q"
                    android:forceDarkAllowed="false" />

                <!-- 5 Tab Touch Targets and Icons Row -->
                <LinearLayout
                    android:id="@+id/tabIconsRow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 1. Home Tab -->
                    <FrameLayout
                        android:id="@+id/tabHome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivTabHome"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_home" />
                    </FrameLayout>

                    <!-- 2. Harbour / Globe Tab -->
                    <FrameLayout
                        android:id="@+id/tabHarbour"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivTabHarbour"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_harbour" />
                    </FrameLayout>

                    <!-- 3. Library Tab -->
                    <FrameLayout
                        android:id="@+id/tabLibrary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivTabLibrary"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_library" />
                    </FrameLayout>

                    <!-- 4. Playlist Tab -->
                    <FrameLayout
                        android:id="@+id/tabPlaylist"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivTabPlaylist"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_playlist" />
                    </FrameLayout>

                    <!-- 5. Settings Tab -->
                    <FrameLayout
                        android:id="@+id/tabSettings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivTabSettings"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_settings" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Swipeable Blank Canvas ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Floating Player Bar Container -->
        <FrameLayout
            android:id="@+id/playerBarWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <!-- Floating Player Card with Guaranteed Hardware Rounded Clipping -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/playerBarCard"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/nav_bar_container_bg"
                app:strokeWidth="1dp"
                app:strokeColor="@color/nav_bar_container_border"
                android:clipChildren="true"
                android:clipToPadding="true"
                tools:targetApi="q"
                android:forceDarkAllowed="false">

                <!-- Inner Frame for Player Layering -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                <!-- Player Content Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <!-- Album Art Cover (Squircle) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardBackgroundColor="@color/background_card"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/ivPlayerAlbumArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_album_art_placeholder" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Song Info (Title + Artist) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPlayerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Nothing playing"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPlayerArtist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="Select a track to listen"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Playback Controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Prev Button -->
                        <FrameLayout
                            android:id="@+id/btnPlayerPrev"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_player_prev"
                                app:tint="@color/text_secondary" />
                        </FrameLayout>

                        <!-- Play / Pause Button -->
                        <FrameLayout
                            android:id="@+id/btnPlayerPlayPause"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivPlayPauseIcon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_player_play"
                                app:tint="@color/tab_active_tint" />
                        </FrameLayout>

                        <!-- Next Button -->
                        <FrameLayout
                            android:id="@+id/btnPlayerNext"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_player_next"
                                app:tint="@color/text_secondary" />
                        </FrameLayout>

                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    </LinearLayout>

    <!-- Fullscreen Player Screen (Expands from bottom player bar) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fullPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- 0. Dynamic Blurred Album Art Background -->
        <ImageView
            android:id="@+id/ivFullPlayerBlurredBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.45" />

        <!-- Deep Gradient Overlay for high-contrast text and controls -->
        <View
            android:id="@+id/fullPlayerDarkOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_player_blur_overlay" />

        <!-- Top Ambient Halo Glow -->
        <View
            android:id="@+id/fullPlayerGlow"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:alpha="0.6"
            android:background="@drawable/bg_ambient_glow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 1. Header Toolbar -->
        <FrameLayout
            android:id="@+id/fullPlayerHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Minimize Button (Chevron Down) -->
            <FrameLayout
                android:id="@+id/btnMinimizePlayer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/content_desc_back"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Header Context Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFullPlayerContextSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="PLAYING FROM"
                    android:textColor="#64748B"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tvFullPlayerContextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:text="Your Library"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Right Actions: Lyrics Toggle + More Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnFullLyricsToggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivFullLyricsIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Lyrics"
                        android:src="@drawable/ic_lyrics"
                        app:tint="#64748B" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnFullPlayerMore"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/content_desc_more"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/text_primary" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Cover Art & Track Info Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCoverSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/fullPlayerHeader"
            app:layout_constraintBottom_toTopOf="@+id/layoutProgressSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Large Album Art Squircle Card (Clean squircle without embedded text) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFullAlbumArt"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="36dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/background_card"
                app:cardCornerRadius="28dp"
                app:cardElevation="14dp"
                app:cardPreventCornerOverlap="true"
                app:strokeColor="#1E2A38"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toTopOf="@+id/layoutCardIndicators"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4">

                <ImageView
                    android:id="@+id/ivFullAlbumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_album_art_placeholder" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Card Page Indicator (Cover Art / Lyrics) -->
            <LinearLayout
                android:id="@+id/layoutCardIndicators"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp"
                app:layout_constraintBottom_toTopOf="@+id/layoutSongInfo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardFullAlbumArt">

                <!-- Dot 1: Cover -->
                <View
                    android:id="@+id/indicatorDotCover"
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_indicator_dot_active" />

                <!-- Dot 2: Lyrics -->
                <View
                    android:id="@+id/indicatorDotLyrics"
                    android:layout_width="6dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_indicator_dot_inactive" />

            </LinearLayout>

            <!-- Song Info (Title & Artist) -->
            <LinearLayout
                android:id="@+id/layoutSongInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvFullTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.01"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="Nothing playing"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvFullArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Select a track to listen"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. Borderless Synced Lyrics Section (Free-floating typography, not inside a box) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutLyricsSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/fullPlayerHeader"
            app:layout_constraintBottom_toTopOf="@+id/layoutProgressSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Lyrics Mini Header (Track Info & Synced Indicator) -->
            <LinearLayout
                android:id="@+id/layoutLyricsMiniHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingTop="8dp"
                android:paddingEnd="28dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLyricsMiniTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLyricsMiniArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLyricsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_preset_chip"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="SYNCED"
                    android:textColor="@color/brand_emerald"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Borderless Synced Lyrics List with Vertical Fading Edges -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLyrics"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fadingEdgeLength="64dp"
                android:overScrollMode="never"
                android:paddingTop="90dp"
                android:paddingBottom="90dp"
                android:requiresFadingEdge="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutLyricsMiniHeader" />

            <!-- Empty State if No Lyrics Found -->
            <LinearLayout
                android:id="@+id/layoutNoLyrics"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutLyricsMiniHeader">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:alpha="0.4"
                    android:src="@drawable/ic_tab_harbour"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="No Lyrics Found"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="No embedded lyrics or .lrc file found for this track"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 4. Progress Section (SeekBar + Time Labels) -->
        <LinearLayout
            android:id="@+id/layoutProgressSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/layoutControlsRow">

            <!-- Interactive Seek Bar -->
            <SeekBar
                android:id="@+id/fullPlayerSeekBar"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressDrawable="@drawable/sb_progress_drawable"
                android:splitTrack="false"
                android:thumb="@drawable/sb_thumb_drawable"
                android:thumbOffset="6dp" />

            <!-- Time Labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFullCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="0:00"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFullTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="0:00"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Playback Controls Row (7 buttons: Shuffle, Prev, -5s, Play/Pause, +5s, Next, Repeat) -->
        <LinearLayout
            android:id="@+id/layoutControlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Shuffle Button -->
            <FrameLayout
                android:id="@+id/btnFullShuffle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_control_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivFullShuffle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shuffle"
                    app:tint="#64748B" />
            </FrameLayout>

            <!-- Previous Button -->
            <FrameLayout
                android:id="@+id/btnFullPrev"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.0"
                android:background="@drawable/bg_control_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_player_prev"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Rewind 5s Button -->
            <FrameLayout
                android:id="@+id/btnFullRewind5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.0"
                android:background="@drawable/bg_control_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_replay_5"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Play / Pause Button (Prominent 64dp Emerald Circle) -->
            <FrameLayout
                android:id="@+id/btnFullPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_play_fullscreen"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivFullPlayPause"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_player_play"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Fast Forward 5s Button -->
            <FrameLayout
                android:id="@+id/btnFullForward5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.0"
                android:background="@drawable/bg_control_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_forward_5"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Next Button -->
            <FrameLayout
                android:id="@+id/btnFullNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.0"
                android:background="@drawable/bg_control_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_player_next"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- Repeat Button -->
            <FrameLayout
                android:id="@+id/btnFullRepeat"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_control_button_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivFullRepeat"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_repeat"
                    app:tint="#64748B" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Loading Screen Container (Fades out into the blank page) -->
    <FrameLayout
        android:id="@+id/loadingScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark">

        <!-- Soft Ambient Halo Glow behind center -->
        <View
            android:id="@+id/ambientGlow"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ambient_glow" />

        <!-- Center Branding & Loading Container -->
        <LinearLayout
            android:id="@+id/brandingContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Center App Logo (Clean Squircle matching system splash) -->
            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:contentDescription="@string/content_desc_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mewsic_logo" />

            <!-- Sleek Loading Bar Track -->
            <FrameLayout
                android:id="@+id/loadingTrack"
                android:layout_width="160dp"
                android:layout_height="3.5dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_loading_track"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Filling Indicator Bar (animates scaleX from 0f to 1f) -->
                <View
                    android:id="@+id/loadingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_loading_indicator" />

            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Branding: "by xeoniii.dev" like Instagram's "from Meta" -->
        <LinearLayout
            android:id="@+id/layoutBottomBranding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.08"
                android:text="by"
                android:textColor="#64748B"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.08"
                android:text="xeoniii.dev"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
