<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- Main Content Container with Top Rounded Navigation Bar & Swipeable Pages -->
    <LinearLayout
        android:id="@+id/blankContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Rounded Navigation Bar Container -->
        <FrameLayout
            android:id="@+id/topBarWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <HorizontalScrollView
                android:id="@+id/navScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_nav_container"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingStart="5dp"
                android:paddingTop="5dp"
                android:paddingEnd="5dp"
                android:paddingBottom="5dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabBarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Home Tab -->
                    <LinearLayout
                        android:id="@+id/tabHome"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_nav_tab_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/ivTabHome"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_home"
                            app:tint="@color/nav_tab_tint_selector" />

                        <TextView
                            android:id="@+id/tvTabHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/tab_home"
                            android:textColor="@color/nav_tab_tint_selector"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Library Tab -->
                    <LinearLayout
                        android:id="@+id/tabLibrary"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_nav_tab_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/ivTabLibrary"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_library"
                            app:tint="@color/nav_tab_tint_selector" />

                        <TextView
                            android:id="@+id/tvTabLibrary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/tab_library"
                            android:textColor="@color/nav_tab_tint_selector"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Playlist Tab -->
                    <LinearLayout
                        android:id="@+id/tabPlaylist"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_nav_tab_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/ivTabPlaylist"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_playlist"
                            app:tint="@color/nav_tab_tint_selector" />

                        <TextView
                            android:id="@+id/tvTabPlaylist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/tab_playlist"
                            android:textColor="@color/nav_tab_tint_selector"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Harbour Tab -->
                    <LinearLayout
                        android:id="@+id/tabHarbour"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_nav_tab_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/ivTabHarbour"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_harbour"
                            app:tint="@color/nav_tab_tint_selector" />

                        <TextView
                            android:id="@+id/tvTabHarbour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/tab_harbour"
                            android:textColor="@color/nav_tab_tint_selector"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Settings Tab -->
                    <LinearLayout
                        android:id="@+id/tabSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_nav_tab_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/ivTabSettings"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_tab_settings"
                            app:tint="@color/nav_tab_tint_selector" />

                        <TextView
                            android:id="@+id/tvTabSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/tab_settings"
                            android:textColor="@color/nav_tab_tint_selector"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>
        </FrameLayout>

        <!-- Swipeable Blank Canvas ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Loading Screen Container (Fades out into the blank page) -->
    <FrameLayout
        android:id="@+id/loadingScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark">

        <!-- Soft Ambient Halo Glow behind center -->
        <View
            android:id="@+id/ambientGlow"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ambient_glow" />

        <!-- Center Branding Container -->
        <LinearLayout
            android:id="@+id/brandingContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Logo + Title Row -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- App Icon -->
                <ImageView
                    android:id="@+id/ivAppIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/content_desc_logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mewsic_logo" />

                <!-- App Title -->
                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.01"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />

            </LinearLayout>

            <!-- Loading Bar Track -->
            <FrameLayout
                android:id="@+id/loadingTrack"
                android:layout_width="190dp"
                android:layout_height="3.5dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_loading_track"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Filling Indicator Bar (animates scaleX from 0f to 1f with midpoint hiccup) -->
                <View
                    android:id="@+id/loadingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_loading_indicator" />

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
