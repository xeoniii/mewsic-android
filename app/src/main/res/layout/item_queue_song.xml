<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutQueueItem"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_song_card_idle"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <!-- Drag Handle (Touch to Reorder) -->
    <FrameLayout
        android:id="@+id/btnQueueDragHandle"
        android:layout_width="32dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:id="@+id/ivQueueDragHandle"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_drag_handle"
            app:tint="#64748B" />
    </FrameLayout>

    <!-- Album Art -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivQueueAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_album_art_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Title & Artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvQueueSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            tools:text="Song Title" />

        <TextView
            android:id="@+id/tvQueueSongArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            tools:text="Artist Name" />
    </LinearLayout>

    <!-- Duration -->
    <TextView
        android:id="@+id/tvQueueSongDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:fontFamily="monospace"
        android:textColor="#64748B"
        android:textSize="11sp"
        tools:text="3:45" />

    <!-- Remove Button -->
    <FrameLayout
        android:id="@+id/btnQueueRemove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_close"
            app:tint="#64748B" />
    </FrameLayout>

</LinearLayout>
