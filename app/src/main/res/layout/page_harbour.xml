<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Ambient background glow -->
    <ImageView
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:alpha="0.20"
        android:scaleType="fitXY"
        android:src="@drawable/bg_ambient_glow" />

    <!-- Main scroll container with floating bar clearance -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/harbourScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="84dp"
        android:paddingBottom="94dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ──── PROVIDER CHIPS ──── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/harbourProviderChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <!-- Chip: iTunes -->
                    <TextView
                        android:id="@+id/chipItunes"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_btn_apply"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="iTunes"
                        android:textColor="@color/tab_active_tint"
                        android:textSize="12.5sp" />

                    <!-- Chip: JioSaavn -->
                    <TextView
                        android:id="@+id/chipJioSaavn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_song_card_idle"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="JioSaavn"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <!-- Chip: YouTube -->
                    <TextView
                        android:id="@+id/chipYoutube"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_song_card_idle"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="YouTube"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                    <!-- Chip: SoundCloud -->
                    <TextView
                        android:id="@+id/chipSoundCloud"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_song_card_idle"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="SoundCloud"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ──── SEARCH BAR ──── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_song_card_idle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.5"
                    android:src="@drawable/ic_tab_harbour"
                    app:tint="@color/tab_active_tint" />

                <EditText
                    android:id="@+id/etHarbourSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:hint="Search songs, artists..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textCursorDrawable="@null"
                    android:textSize="13.5sp" />

                <!-- Clear button (hidden until text entered) -->
                <ImageView
                    android:id="@+id/ivHarbourClear"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:alpha="0.6"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_delete"
                    android:visibility="gone"
                    app:tint="#8E9BAE" />

                <!-- Search button -->
                <FrameLayout
                    android:id="@+id/btnHarbourSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_btn_apply"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:text="Search"
                        android:textColor="@color/tab_active_tint"
                        android:textSize="12.5sp" />
                </FrameLayout>

            </LinearLayout>

            <!-- ──── CONTENT AREA (Loading / Results / Empty / Error) ──── -->

            <!-- Loading spinner -->
            <LinearLayout
                android:id="@+id/harbourLoadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="60dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/tab_active_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Scanning the airwaves..."
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Error state -->
            <LinearLayout
                android:id="@+id/harbourErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="60dp"
                android:paddingEnd="32dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_delete_icon_badge">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_harbour"
                        app:tint="#EF4444" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Search Failed"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvHarbourErrorMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#64748B"
                    android:textSize="12.5sp"
                    tools:text="Unable to reach the provider. Check your internet connection." />

                <FrameLayout
                    android:id="@+id/btnHarbourRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_song_card_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:text="Try Again"
                        android:textColor="#8E9BAE"
                        android:textSize="13sp" />
                </FrameLayout>

            </LinearLayout>

            <!-- Empty / idle state -->
            <LinearLayout
                android:id="@+id/harbourEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="60dp"
                android:paddingBottom="40dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.18"
                    android:src="@drawable/ic_tab_harbour"
                    app:tint="@color/tab_active_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ready to Discover?"
                    android:textColor="#334155"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Enter a song or artist above."
                    android:textColor="#1E293B"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <!-- Results RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHarbourResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingTop="6dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
